{
  "name": "coding",
  "label": "Coding",
  "hint": "Everything one node's coding agent is asked to do: a dispatched piece of work (cold, or continuing after a blocker), a structured split/merge request, and a direct chat about the node it owns.",
  "nodes": [
    { "id": "message", "title": "On message", "onMessage": {} },

    { "id": "retrying", "title": "Retrying?", "step": "retrying" },
    { "id": "implement", "title": "Implement", "turn": { "brief": "prompts/node-compile.md.mustache" } },
    { "id": "continue", "title": "Continue", "turn": { "brief": "prompts/node-reconcile.md.mustache", "session": "message" } },

    { "id": "request-op", "title": "Which op?", "step": "request-op" },
    { "id": "split-stage", "title": "Split stage", "turn": { "brief": "prompts/split-stage.md.mustache" } },
    { "id": "merge", "title": "Merge", "turn": { "brief": "prompts/merge.md.mustache" } },

    { "id": "resuming", "title": "Resuming?", "step": "resuming" },
    { "id": "chat", "title": "Chat turn", "turn": { "brief": "prompts/node-chat.md.mustache" } },
    { "id": "chat-resumed", "title": "Resumed chat", "turn": { "brief": "prompts/node-chat-resumed.md.mustache", "session": "message" } }
  ],
  "edges": [
    { "from": "message", "outcome": "work", "to": "retrying" },
    { "from": "message", "outcome": "request", "to": "request-op" },
    { "from": "message", "outcome": "chat", "to": "resuming" },
    { "from": "resuming", "outcome": "no", "to": "chat" },
    { "from": "resuming", "outcome": "yes", "to": "chat-resumed" },

    { "from": "retrying", "outcome": "no", "to": "implement" },
    { "from": "retrying", "outcome": "yes", "to": "continue" },

    { "from": "request-op", "outcome": "split", "to": "split-stage" },
    { "from": "request-op", "outcome": "merge", "to": "merge" }
  ]
}

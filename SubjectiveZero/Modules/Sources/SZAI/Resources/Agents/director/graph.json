{
  "label": "Director Agent",
  "symbol": "eyeglasses",
  "tint": "purple",
  "slots": [
    { "id": "planner", "label": "Plan",
      "description": "Plans the graph, briefs each node, and checks the results" },
    { "id": "assistant", "label": "Chat",
      "description": "Answers you in chat" },
    { "id": "sorter", "label": "Sort",
      "description": "Decides whether each message is new work, a change, or a question" }
  ],
  "asks": "sorter",
  "nodes": [
    { "id": "door", "title": "On message", "step": "door", "ask": "sorter" },
    { "id": "decompose", "title": "Decompose", "turn": { "brief": "decompose", "slot": "planner", "context": "conversation" } },
    { "id": "convert", "title": "Convert", "turn": { "brief": "convert", "slot": "planner", "context": "conversation" } },
    { "id": "implement", "title": "Implement", "dispatch": { "to": "coding" } },
    { "id": "unresolved", "title": "Still unresolved?", "step": "work-left" },
    { "id": "reconcile", "title": "Reconcile", "turn": { "brief": "reconcile", "session": "resume", "slot": "planner" } },
    { "id": "amend", "title": "Amend scheduled work", "turn": { "brief": "amend", "slot": "planner", "context": "conversation" } },
    { "id": "chat", "title": "Catch up and answer", "turn": { "brief": "chat", "slot": "assistant", "context": "conversation" } },
    { "id": "chat-resumed", "title": "Answer", "turn": { "brief": "chat-resumed", "session": "resume", "slot": "assistant" } }
  ],
  "edges": [
    { "from": "door", "outcome": "build", "to": "decompose" },
    { "from": "door", "outcome": "convert", "to": "convert" },
    { "from": "door", "outcome": "amend", "to": "amend" },
    { "from": "door", "outcome": "answer", "to": "chat" },
    { "from": "door", "outcome": "answer-resumed", "to": "chat-resumed" },
    { "from": "decompose", "outcome": "ok", "to": "implement" },
    { "from": "convert", "outcome": "ok", "to": "implement" },
    { "from": "implement", "outcome": "settled", "to": "unresolved", "maxTraversals": 2 },
    { "from": "unresolved", "outcome": "yes", "to": "reconcile" },
    { "from": "reconcile", "outcome": "ok", "to": "implement" }
  ]
}

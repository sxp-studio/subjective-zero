{
  "name": "director",
  "label": "Director",
  "hint": "Every message the director receives and what it does with each: a chat turn routed by its own ruling; a build opened under the chosen strategy; the fleet's settled reply arriving back through the same door.",
  "caps": { "rounds": 2 },
  "nodes": [
    { "id": "message", "title": "On message", "onMessage": {} },

    { "id": "resuming", "title": "Resuming?", "step": "resuming" },
    { "id": "cold", "title": "Cold turn", "turn": { "brief": "prompts/chat.md.mustache" } },
    { "id": "resumed", "title": "Resumed turn", "turn": { "brief": "prompts/chat-resumed.md.mustache", "session": "message" } },
    { "id": "route-reply", "title": "Route the reply", "step": "route-reply" },

    { "id": "strategy", "title": "Strategy", "step": "strategy" },
    { "id": "strategy-settled", "title": "Strategy (settled)", "step": "strategy" },

    { "id": "decompose", "title": "Decompose", "turn": { "brief": "prompts/decompose.md.mustache" } },
    { "id": "work-left", "title": "Work left?", "step": "work-left" },
    { "id": "work-left-settled", "title": "Work left now?", "step": "work-left" },
    { "id": "nodes-failing", "title": "Nodes failing?", "step": "nodes-failing" },
    { "id": "reconcile", "title": "Reconcile", "turn": { "brief": "prompts/reconcile.md.mustache", "session": "message" } },
    { "id": "implement", "title": "Implement", "dispatch": { "to": "coding", "items": "workSet" } }
  ],
  "edges": [
    { "from": "message", "outcome": "chat", "to": "resuming" },
    { "from": "message", "outcome": "build", "to": "strategy" },
    { "from": "message", "outcome": "settled", "to": "strategy-settled" },

    { "from": "resuming", "outcome": "no", "to": "cold" },
    { "from": "resuming", "outcome": "yes", "to": "resumed" },
    { "from": "cold", "outcome": "ok", "to": "route-reply" },
    { "from": "resumed", "outcome": "ok", "to": "route-reply" },

    { "from": "strategy", "outcome": "agentic", "to": "decompose" },
    { "from": "strategy", "outcome": "procedural", "to": "work-left" },
    { "from": "strategy", "outcome": "recovery", "to": "nodes-failing" },

    { "from": "strategy-settled", "outcome": "agentic", "to": "work-left-settled" },
    { "from": "strategy-settled", "outcome": "recovery", "to": "nodes-failing" },

    { "from": "decompose", "outcome": "ok", "to": "implement" },
    { "from": "work-left", "outcome": "yes", "to": "implement" },
    { "from": "work-left-settled", "outcome": "yes", "to": "reconcile" },
    { "from": "nodes-failing", "outcome": "yes", "to": "reconcile" },
    { "from": "reconcile", "outcome": "ok", "to": "implement" }
  ]
}
